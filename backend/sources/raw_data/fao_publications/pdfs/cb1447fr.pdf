   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">24707_0824</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">08 Setptember 2010, Sukkur - Collecting clean drinking water from a communal tap in a camp for internally displaced persons (IDP) caused by the floods. Nearly 20 million people have been affected by the floods in Pakistan, many fleeing their homes and seeking refuge in other places.</rdf:li>
    </rdf:Alt>
   </dc:description>
