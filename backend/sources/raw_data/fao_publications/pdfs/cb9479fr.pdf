   photoshop:country="KENYA"
   photoshop:source="FAO"
   photoshop:LegacyIPTCDigest="B702D7D475C0CD10DB3BE0A199369B67"
   photoshop:City="Makueni"
   photoshop:Country="KENYA"
   photoshop:Credit="Â© FAO/Luis Tato"
   photoshop:Source="FAO"
   photoshop:ColorMode="3"
   photoshop:ICCProfile="Adobe RGB (1998)"
   photoshop:DateCreated="2019-06-04"
   xmp:CreateDate="2019-06-04"
   xmp:MetadataDate="2022-10-18T11:04:21+02:00"
   xmp:ModifyDate="2022-10-18T11:04:21+02:00"
   xmpRights:WebStatement="https://mediabase.fao.org/terms-and-conditions"
   xmpRights:Marked="True"
   dc:format="image/jpeg"
   xmpMM:DocumentID="adobe:docid:photoshop:760cdf50-d329-2443-938b-b8f472bb5150"
   xmpMM:InstanceID="xmp.iid:ce5eb23d-6979-4d6d-bb58-f3c5b70ac944"
   xmpMM:OriginalDocumentID="F15EE000B1A010F937E9DF312E14DB31">
   <photoshop:DocumentAncestors>
    <rdf:Bag>
     <rdf:li>F15EE000B1A010F937E9DF312E14DB31</rdf:li>
    </rdf:Bag>
   </photoshop:DocumentAncestors>
   <xmpRights:UsageTerms>
    <rdf:Alt>
     <rdf:li xml:lang="x-repair">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </xmpRights:UsageTerms>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Africa</rdf:li>
     <rdf:li>Kenya</rdf:li>
     <rdf:li>FAO Project</rdf:li>
     <rdf:li>Training</rdf:li>
     <rdf:li>Farmers</rdf:li>
     <rdf:li>Women</rdf:li>
     <rdf:li>Men</rdf:li>
     <rdf:li>Agriculture</rdf:li>
     <rdf:li>Conservation</rdf:li>
     <rdf:li>Teaching</rdf:li>
     <rdf:li>Planting Machine</rdf:li>
     <rdf:li>Tractor</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">4 June 2019, Makueni County, Kenya - A farmer drives a tractor with a ripping and planting machine in a farm near Kathonzweni, Makueni County, Kenya on June 4, 2019. This group of farmers has improved their livelihood through sustainable agricultural mechanization with a ripping and planting machine donated by FAO.&amp;#xA;The objective of the IPP-GAP case study project conducted by the Food and Agriculture Organisation is to contribute to the evaluation of Outcome 2 of&amp;#xA;FAO's CPF in Kenya, and more specifically to describe and analyse positive outcomes and benefits in the life of beneficiaries, and the factors that have contributed to these outcomes&amp;#xA;or affected the success of the actions.&amp;#xA;The main activities planned in the project are: Implementation of a large extension programme on CA and GAP in order to improve&amp;#xA;the knowledge and capacities of farmers, based on a cascade training from Masters of&amp;#xA;Trainers (MoT), Trainers of Farmers (ToF) to farmers, and on a farmer field school&amp;#xA;approach, Development of an e-agriculture platform, Support institutionalization of CA and GAP support capacity of government, private&amp;#xA;sector and NGO extension workers, Support the creation of new market linkages and modalities (collective contracts)&amp;#xA;between famer groups and final buyers.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:79d67af2-5122-44aa-879d-41ef4f1970ee"
      stEvt:when="2022-10-18T11:04:21+02:00"
      stEvt:softwareAgent="Adobe Photoshop 23.5 (Macintosh)"
      stEvt:changed="/"/>
     <rdf:li
