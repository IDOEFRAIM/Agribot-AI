"""
Routes API - Définition des endpoints de l'API AgriConnect
"""

import os
import logging
from pathlib import Path
from fastapi import APIRouter, HTTPException, BackgroundTasks
from fastapi.responses import FileResponse

from backend.orchestrator.message_flow import MessageResponseFlow
from backend.orchestrator.state import GlobalAgriState
from backend.agents.formation import FormationCoach
from .schemas import (
    UserRequest,
    SuccessResponse,
    AsyncQueuedResponse,
    TaskStatusResponse,
    HealthResponse,
    RootResponse,
)

logger = logging.getLogger("AgConnectAPI")

router = APIRouter()

# Initialize Orchestrator
try:
    orchestrator_instance = MessageResponseFlow()
    # instantiate heavy coaches lazily when needed to avoid startup overhead
    coach = None
    logger.info("✅ Orchestrator loaded successfully.")
except Exception as e:
    logger.error(f"❌ Failed to load Orchestrator: {e}")
    orchestrator_instance = None


def detect_agent_type(query: str) -> str:
    """Détecte le type d'agent à partir de la query."""
    query_lower = query.lower()
    if any(word in query_lower for word in ["météo", "pluie", "climat", "alerte"]):
        return "sentinel"
    elif any(word in query_lower for word in ["maladie", "insecte", "feuille"]):
        return "doctor"
    elif any(word in query_lower for word in ["prix", "marché", "vendre", "acheter"]):
        return "market"
    return "general"


@router.post("/api/v1/ask")
async def ask_agent(req: UserRequest, background_tasks: BackgroundTasks):
    """
    Endpoint principal pour interagir avec l'Orchestrateur AgConnect.
    
    - async_mode=False: Traitement synchrone (réponse immédiate)
    - async_mode=True: Queue vers Celery (pour TTS, tasks longues)
    """
    if orchestrator_instance is None:
        raise HTTPException(status_code=503, detail="Orchestrator not initialized")

    logger.info(f"📨 Request: user={req.user_id}, zone={req.zone_id}, async={req.async_mode}")

    # MODE ASYNC: Queue vers Celery worker
    if req.async_mode:
        try:
            from backend.workers.tasks.ai import generate_agent_response

            agent_type = detect_agent_type(req.query)

            task = generate_agent_response.delay(
                user_query=req.query,
                agent_type=agent_type,
                user_profile={"zone": req.zone_id, "crop": req.crop},
                voice_enabled=True,
            )

            return {
                "status": "queued",
                "task_id": task.id,
                "message": "Votre demande est en cours de traitement...",
                "check_status_at": f"/api/v1/task/{task.id}",
            }

        except Exception as e:
            logger.error(f"❌ Async queueing failed: {e}")
            req.async_mode = False  # Fallback en synchrone

    # MODE SYNCHRONE (par défaut)
    initial_state: GlobalAgriState = {
        "requete_utilisateur": req.query,
        "zone_id": req.zone_id,
        "user_id": req.user_id,
        "crop": req.crop,
        "user_reliability_score": 1.0,
        "is_sms_mode": False,
        "flow_type": req.flow_type,
        "execution_path": [],
        "meteo_data": {},
        "market_data": {},
        "global_alerts": [],
        "audio_url": None,
    }

    try:
        result = orchestrator_instance.run(initial_state)
        final_text = result.get("final_response", "Je n'ai pas pu générer de réponse.")
        audio_url = result.get("audio_url")

        # Si un fichier audio a été généré, construire l'URL de téléchargement
        audio_download = None
        if audio_url:
            audio_id = Path(audio_url).stem
            audio_download = f"/api/v1/audio/{audio_id}"

        logger.info("✅ Response generated (audio=%s)", "yes" if audio_url else "no")

        return {
            "status": "success",
            "response": final_text,
            "audio_url": audio_download,
            "trace": result.get("execution_path", []),
        }

    except Exception as e:
        logger.error(f"❌ Orchestrator execution failed: {e}", exc_info=True)
        raise HTTPException(status_code=500, detail=str(e))


@router.get("/api/v1/task/{task_id}")
async def get_task_status(task_id: str):
    """Vérifier le statut d'une tâche Celery async."""
    try:
        from backend.workers.celery_app import celery_app

        task_result = celery_app.AsyncResult(task_id)

        if task_result.ready():
            if task_result.successful():
                return {"status": "completed", "result": task_result.result}
            else:
                return {"status": "failed", "error": str(task_result.result)}
        else:
            return {"status": "processing", "task_id": task_id}

    except Exception as e:
        logger.error(f"Task status error: {e}")
        raise HTTPException(status_code=404, detail="Task not found")


# ============================================
# AUDIO DOWNLOAD
# ============================================

AUDIO_DIR = Path(os.getenv("AUDIO_STORAGE_DIR", "audio_output")).resolve()
# Ensure audio directory exists so FileResponse can serve files
AUDIO_DIR.mkdir(parents=True, exist_ok=True)


@router.get("/api/v1/audio/{audio_id}")
async def download_audio(audio_id: str):
    """Télécharger un fichier audio généré par le TTS."""
    file_path = AUDIO_DIR / f"{audio_id}.wav"
    if not file_path.exists():
        raise HTTPException(status_code=404, detail="Audio file not found")
    return FileResponse(
        path=str(file_path),
        media_type="audio/wav",
        filename=f"{audio_id}.wav",
    )


@router.get("/health")
def health_check():
    """Health check endpoint."""
    return {"status": "active", "component": "AgConnect Backend"}


@router.get("/")
def root():
    """Root endpoint."""
    return {
        "name": "AgriConnect Backend",
        "version": "2.0.0",
        "status": "running",
        "architecture": "event-driven",
        "docs": "/docs",
    }
